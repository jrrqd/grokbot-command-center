# HTTP Basic Auth for the Command Center UI and API (except bot ingest).
# If COMMAND_CENTER_PASSWORD is unset, auth is disabled (local dev).
COMMAND_CENTER_USER=admin
COMMAND_CENTER_PASSWORD=

# Webhook for operator actions (project responses, content actions, routines).
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=

# Bot ingest keys: JSON map of bot name -> SHA-256 hex of the raw key.
# Generate with: npm run generate-bot-key -- lucius
GROKBOT_KEYS_JSON={"lucius":"<sha256-hex>"}

# When true, seed data is not written to disk (use client localStorage demo mode).
CC_DEMO_MODE=false